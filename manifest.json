{
  "manifest_version": 3,
  "name": "Bilibili AI Subtitle Downloader",
  "description": "探测 Bilibili 视频页已触发的 AI 字幕请求，并下载 JSON + SRT ZIP。",
  "version": "0.1.0",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://aisubtitle.hdslb.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Bilibili AI 字幕下载",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}
